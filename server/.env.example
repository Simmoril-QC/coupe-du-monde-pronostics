# Pronos Multi-Sports — configuration serveur
# Copiez ce fichier en `.env` et remplissez les valeurs.
# (Le serveur lit les variables d'environnement ; en dev, `node index.js` suffit.)

# Port HTTP du serveur
PORT=8080

# URL publique du front (pour générer les liens magic)
# En dev : http://localhost:5173  |  En prod : https://votre-domaine
APP_URL=http://localhost:5173

# Chemin du fichier SQLite (défaut : data.sqlite à côté de index.js)
#DB_PATH=./data.sqlite

# ---- SMTP (envoi des emails magic-link + invitations) ----
# Sans SMTP_HOST : les liens sont affichés dans la console (mode dev/test).
# Avec : configurez votre serveur mail (ex: Gmail, Mailgun, OVH, Hetzner Mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pronos Multi-Sports <vous@votre-domaine.com>"
